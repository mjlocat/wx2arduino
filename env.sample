# MQTT broker host
MQTT_HOST=master

# MQTT broker port
MQTT_PORT=1883

# Optional MQTT credentials (leave blank for anonymous)
MQTT_USER=
MQTT_PASS=

# Topics (numeric payloads). Temperature in F, wind in mph, rain in inches in the last hour
TOPIC_TEMPERATURE=rtl_433/master/devices/Acurite-5n1/A/2363/temperature_F
TOPIC_HUMIDITY=rtl_433/master/devices/Acurite-5n1/A/2363/humidity
TOPIC_WIND=rtl_433/master/devices/Acurite-5n1/A/2363/wind_avg_mi_h
TOPIC_RAIN=house/wx/rain_1h

# Serial device for Arduino (suggest using /dev/serial/by-id reference as it's consistent)
SERIAL_PORT=/dev/serial/by-id/usb-Arduino__www.arduino.cc__0043_A4132373935351605241-if00

# Number of seconds between refreshes
REFRESH=10
